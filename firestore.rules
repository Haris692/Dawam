rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Groupes : lecture ouverte à tout utilisateur authentifié (nécessaire pour rejoindre)
    match /groups/{groupId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.adminUid
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.auth.uid;

      allow update: if request.auth != null && (
        // Membre existant qui incrémente le compteur
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'completedAt']))
        ||
        // Nouvel utilisateur qui rejoint
        (!(request.auth.uid in resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 20
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames']))
        ||
        // Membre qui quitte (se retire de members + memberNames)
        (request.auth.uid in resource.data.members
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames']))
        ||
        // Membre qui coche son Qiyam (champ qiyam uniquement)
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qiyam']))
        ||
        // Admin met à jour la cible Qiyam semaine
        (request.auth.uid == resource.data.adminUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qiyamWeekTarget']))
        ||
        // Admin peut tout modifier
        request.auth.uid == resource.data.adminUid
      );

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.adminUid;
    }

    // Codes d'invitation : tout utilisateur authentifié peut lire et créer
    match /groupCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
